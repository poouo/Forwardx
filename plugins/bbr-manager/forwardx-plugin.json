{
  "schemaVersion": 1,
  "id": "bbr-manager",
  "name": "ForwardX BBR 管理",
  "version": "1.0.0",
  "description": "按主机读取、配置和还原 BBR / TCP 参数，支持图形化与高级 sysctl 文本。",
  "detailsMarkdown": "管理员可按主机读取真实拥塞控制算法、默认队列及现有网卡队列。支持图形化与高级文本双向编辑、BBR + FQ 预设、持久化和原参数还原。\n\n仅使用 Agent 上的 Python 3 标准库与系统 sysctl，不安装内核、不下载第三方脚本、不重建网卡队列。仅在管理员保存后修改参数，安装或启用插件不自动启用 BBR。",
  "author": "ForwardX",
  "logo": "data:image/svg+xml;base64,",
  "releaseDate": "2026-10-21",
  "updatedAt": "2026-10-21",
  "changelog": "新增按主机 BBR / TCP 参数读取、双模式配置、BBR + FQ 预设及还原。",
  "tags": ["bbr", "tcp", "sysctl", "agent"],
  "license": "AGPL-3.0-only",
  "homepage": "https://github.com/poouo/Forwardx",
  "repository": "https://github.com/poouo/Forwardx",
  "features": [
    { "title": "真实参数", "description": "读取内核拥塞算法、默认队列和现有接口队列。" },
    { "title": "双模式编辑", "description": "图形化与高级文本共用配置，保留自定义参数及注释。" },
    { "title": "通用预设", "description": "提供仅包含 BBR + FQ 的简洁预设。" },
    { "title": "安全还原", "description": "写入校验、失败回滚，支持恢复插件修改前的参数。" }
  ],
  "permissions": ["read:hosts", "agent:read", "agent:write", "ui:interactive", "ui:page"],
  "extensionPoints": ["sidebar.page"],
  "sidebar": { "label": "BBR 管理", "target": "usage" },
  "usageViews": [{
    "id": "sync-to-hosts",
    "type": "host-asset-sync",
    "storageKey": "bbrManagerUsage",
    "title": "BBR 管理",
    "description": "选择主机读取真实内核参数，编辑或应用预设；各主机独立配置。",
    "hostScope": "all",
    "targetDirectory": "/var/lib/forwardx-agent/plugins/bbr-manager",
    "assetMode": "all-plugin-assets",
    "preserveAssetPaths": true,
    "assetSelector": { "hidden": true }
  }],
  "resourceSchemas": [{
    "id": "bbr-host-manager",
    "type": "agent-resource",
    "title": "TCP / BBR 配置",
    "description": "列表展示实时值；默认队列与现有网卡队列分别展示。",
    "usageViewId": "sync-to-hosts",
    "rowKey": "id",
    "listSourceId": "kernel-list",
    "detailSourceId": "kernel-detail",
    "sources": [
      { "id": "kernel-list", "actionId": "read-kernel-list", "triggers": ["onOpen", "onHostSelected"], "itemsPath": "items", "cacheTtlMs": 3000 },
      { "id": "kernel-detail", "actionId": "read-kernel-detail", "triggers": ["manual"] }
    ],
    "columns": [
      { "key": "name", "label": "配置", "type": "text" },
      { "key": "congestionControl", "label": "拥塞控制", "type": "code" },
      { "key": "defaultQdisc", "label": "默认队列", "type": "code" },
      { "key": "availableAlgorithms", "label": "可用算法", "type": "text" },
      { "key": "currentQueues", "label": "现有网卡队列", "type": "text" },
      { "key": "persisted", "label": "插件配置", "type": "status", "trueLabel": "已保存", "falseLabel": "未配置" },
      { "key": "inSync", "label": "运行值与保存值", "type": "status", "trueLabel": "一致", "falseLabel": "未配置或有差异" }
    ],
    "fields": [
      { "key": "configText", "label": "内核网络参数", "type": "sysctl", "required": true, "defaultValue": "net.core.default_qdisc = fq\nnet.ipv4.tcp_congestion_control = bbr\n" },
      { "key": "runtimeText", "label": "当前运行参数", "type": "textarea", "readOnly": true, "description": "实时读取，仅供对照；未纳入上方配置的参数不会下发。" },
      { "key": "savedConfigText", "label": "已保存配置", "type": "textarea", "readOnly": true, "description": "持久化文件原文，仅供对照。上方编辑器按当前运行值填充已配置参数。" }
    ],
    "operations": {
      "update": { "actionId": "apply-kernel-config", "label": "配置 BBR / TCP", "confirmRequired": true, "description": "将修改所选主机的内核网络参数并持久化。移除的参数恢复为插件首次修改前的值。", "refreshAfter": ["kernel-list"] },
      "execute": [
        { "actionId": "apply-preset", "label": "应用 BBR + FQ", "confirmRequired": true, "description": "以 BBR + FQ 两项替换插件配置。此前配置的其他参数将恢复原值，不替换现有网卡队列。", "refreshAfter": ["kernel-list"] },
        { "actionId": "restore-kernel-config", "label": "还原原参数", "confirmRequired": true, "description": "恢复插件修改前的参数与插件配置文件，不修改其他 sysctl 文件。", "refreshAfter": ["kernel-list"] }
      ]
    }
  }],
  "actions": [
    { "id": "read-kernel-list", "label": "读取内核参数", "type": "agent.request", "intent": "read", "agent": { "executor": "script", "interpreter": "python3", "target": "selected-hosts", "usageViewId": "sync-to-hosts", "entry": "manage.py", "arguments": ["list"], "timeoutMs": 30000, "outputType": "json" } },
    { "id": "read-kernel-detail", "label": "读取配置详情", "type": "agent.request", "intent": "read", "agent": { "executor": "script", "interpreter": "python3", "target": "selected-hosts", "usageViewId": "sync-to-hosts", "entry": "manage.py", "arguments": ["read"], "timeoutMs": 30000, "outputType": "json" } },
    { "id": "apply-kernel-config", "label": "保存并应用配置", "type": "agent.request", "intent": "write", "agent": { "executor": "script", "interpreter": "python3", "target": "selected-hosts", "usageViewId": "sync-to-hosts", "entry": "manage.py", "arguments": ["apply", "{{input.configText}}"], "timeoutMs": 60000, "outputType": "json" } },
    { "id": "apply-preset", "label": "应用 BBR + FQ", "type": "agent.request", "intent": "write", "agent": { "executor": "script", "interpreter": "python3", "target": "selected-hosts", "usageViewId": "sync-to-hosts", "entry": "manage.py", "arguments": ["preset"], "timeoutMs": 60000, "outputType": "json" } },
    { "id": "restore-kernel-config", "label": "还原原参数", "type": "agent.request", "intent": "write", "agent": { "executor": "script", "interpreter": "python3", "target": "selected-hosts", "usageViewId": "sync-to-hosts", "entry": "manage.py", "arguments": ["restore"], "timeoutMs": 60000, "outputType": "json" } }
  ],
  "pages": [{ "id": "overview", "title": "使用说明", "contentType": "markdown", "assetPath": "README.md" }],
  "assets": [
    { "path": "README.md", "label": "使用说明", "contentType": "text/markdown;charset=utf-8" },
    { "path": "manage.py", "label": "内核参数管理程序", "contentType": "text/x-python;charset=utf-8" },
    { "path": "logo.svg", "label": "BBR Logo", "contentType": "image/svg+xml" },
    { "path": "LICENSE.txt", "label": "许可证", "contentType": "text/plain;charset=utf-8" }
  ]
}
