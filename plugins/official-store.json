    {
      "id": "bbr-manager",
      "name": "ForwardX BBR 管理",
      "description": "按主机读取、配置和还原 BBR / TCP 参数，支持图形化与高级 sysctl 文本。",
      "detailsMarkdown": "管理员可按主机读取真实拥塞控制算法、默认队列及现有网卡队列。支持图形化与高级文本双向编辑、BBR + FQ 预设、持久化和原参数还原。\n\n仅使用 Agent 上的 Python 3 标准库与系统 sysctl，不安装内核、不下载第三方脚本、不重建网卡队列。仅在管理员保存后修改参数，安装或启用插件不自动启用 BBR。",
      "version": "1.0.0",
      "releaseDate": "2026-10-21",
      "updatedAt": "2026-10-21",
      "changelog": "新增按主机 BBR / TCP 参数读取、双模式配置、BBR + FQ 预设及还原。",
      "logo": "data:image/svg+xml;base64,",
      "features": [
        {
          "title": "真实参数",
          "description": "读取内核拥塞算法、默认队列和现有接口队列。"
        },
        {
          "title": "双模式编辑",
          "description": "图形化与高级文本共用配置，保留自定义参数及注释。"
        },
        {
          "title": "通用预设",
          "description": "提供仅包含 BBR + FQ 的简洁预设。"
        },
        {
          "title": "安全还原",
          "description": "写入校验、失败回滚，支持恢复插件修改前的参数。"
        }
      ],
      "tags": [
        "bbr",
        "tcp",
        "sysctl",
        "agent"
      ],
      "license": "AGPL-3.0-only",
      "repository": "https://github.com/poouo/Forwardx",
      "branch": "main",
      "manifestPath": "plugins/bbr-manager/forwardx-plugin.json",
      "homepage": "https://github.com/poouo/Forwardx",
      "author": "ForwardX",
      "packageRepository": "https://github.com/poouo/Forwardx",
      "packageBranch": "main",
      "packagePath": "plugins/packages/bbr-manager.tar.gz",
      "bundledPath": "plugins/bbr-manager",
      "category": "automation",
      "permissions": [
        "read:hosts",
        "agent:read",
        "agent:write",
        "ui:interactive",
        "ui:page"
      ],
      "extensionPoints": [
        "sidebar.page"
      ],
      "official": true,
      "builtIn": true
    },
    {
      "id": "china-region-whitelist",
      "name": "ForwardX 中国区域白名单",
      "description": "按主机实时管理中国大陆全国、省级 CIDR 和 ASN 白名单规则。",
      "detailsMarkdown": "ForwardX 中国区域白名单插件用于把中国大陆全国、省级 CIDR 和 ASN 白名单规则应用到 Agent 主机。\n\n启用后，插件程序和数据会自动同步到所有 Agent。左侧展示全部主机并支持筛选；点击主机后，可在右侧新增、查看、修改、删除和刷新实际白名单规则。每台 Agent 的配置与状态独立，切换主机不会混用数据。\n\n支持全国或按省份选择全局入站白名单、额外 ASN、端口优先白名单、nftables 或 iptables/ipset，并实时展示在线、执行、规则挂载和失败状态。",
      "version": "0.7.1",
      "releaseDate": "2026-08-22",
      "updatedAt": "2026-08-22",
      "changelog": "修复 nftables DNAT/FORWARD 端口匹配失败、应用错误吞掉及服务状态误报。",
      "logo": "data:image/svg+xml;base64,",
      "features": [
        {
          "title": "区域白名单",
          "description": "支持全国 CN 或按省份选择入站白名单。"
        },
        {
          "title": "端口策略",
          "description": "支持为指定端口或端口范围设置独立白名单。"
        },
        {
          "title": "Agent 下发",
          "description": "按 Agent 实时读取、编辑、应用和清理独立配置。"
        },
        {
          "title": "实时状态",
          "description": "展示防火墙后端、规则数量、持久化状态和执行错误。"
        }
      ],
      "tags": ["whitelist", "china-region", "firewall", "agent"],
      "license": "AGPL-3.0-only",
      "repository": "https://github.com/poouo/Forwardx",
      "branch": "main",
      "manifestPath": "plugins/china-region-whitelist/forwardx-plugin.json",
      "homepage": "https://github.com/poouo/Forwardx",
      "author": "poouo",
      "packageRepository": "https://github.com/poouo/Forwardx",
      "packageBranch": "main",
      "packagePath": "plugins/packages/china-region-whitelist.tar.gz",
      "bundledPath": "plugins/china-region-whitelist",
      "category": "data",
      "permissions": ["data:whitelist", "read:hosts", "agent:read", "agent:write", "ui:interactive", "ui:page"],
      "extensionPoints": ["data.whitelist", "sidebar.page"],
      "official": true,
      "builtIn": true
    },
    {
      "id": "live2d-widget",
      "name": "ForwardX Live2D 看板娘",
      "description": "在面板中按需启用并配置 stevenjoezhang/live2d-widget 看板娘。",
      "detailsMarkdown": "ForwardX Live2D 看板娘是 `stevenjoezhang/live2d-widget` 的官方适配插件。\n\n插件默认关闭；安装并启用后，浏览器才会按设置加载固定版本的上游运行时和模型资源。面板端不执行插件包内的任意 JavaScript。\n\n- 可设置显示范围、移动端显示、模型 CDN、默认模型和停靠位置。\n- 可选择一言、切换模型、换装、拍照、项目说明和关闭等工具。\n- 可设置拖动、关闭后的重新唤起方式和日志等级。\n- ForwardX 不打包 Live2D 模型；模型资源的许可由所配置的模型仓库单独决定。",
      "version": "1.0.1",
      "releaseDate": "2026-07-24",
      "updatedAt": "2026-10-21",
      "changelog": "补充原创看板娘 Logo。",
      "logo": "data:image/svg+xml;base64,",
      "features": [
        { "title": "按需加载", "description": "插件关闭时不加载 Live2D 脚本、模型或周期任务。" },
        { "title": "完整配置", "description": "管理模型来源、默认模型、工具、拖动和关闭行为。" },
        { "title": "显示控制", "description": "支持访问范围、移动端开关、左右停靠和模型尺寸。" },
        { "title": "合规声明", "description": "明确区分上游运行时代码、Cubism 运行时和模型资源许可。" }
      ],
      "tags": ["live2d", "widget", "ui", "waifu"],
