# ForwardX 端口转发管理面板 - 环境变量配置
# 复制此文件为 .env 并修改对应值

# ==================== 数据库配置 ====================
# SQLite 数据库文件路径（Docker 部署时挂载到 /data 目录）
SQLITE_PATH=/data/forwardx.db

# 数据库健康检查（可选；通常保留默认值）。Docker 需同时通过 Compose environment 传入。
# FORWARDX_DB_HEALTH_INTERVAL_MS=15000
# FORWARDX_DB_HEALTH_TIMEOUT_MS=6000
# FORWARDX_DB_HEALTH_FAILURE_THRESHOLD=3

# ==================== 安全配置 ====================
# JWT 签名密钥：无需手动填写。一键安装生成独立的 64 位十六进制随机值；
# 手动 Docker 部署留空时，应用自动生成并持久保存到数据卷 /data/jwt.secret。
# 不要将真实密钥提交到 Git 或分享 .env；升级会保留已有密钥。
JWT_SECRET=

# ==================== 应用配置 ====================
# 运行环境
NODE_ENV=production

# 监听端口
PORT=9810

# Docker 部署镜像。默认使用 GitHub Packages 预编译镜像，不需要在服务器上本地构建。
FORWARDX_IMAGE=ghcr.io/poouo/forwardx:latest

# 旧版 Agent/FXP 加密协议时间自动校准（不会修改宿主机或 Docker 系统时间）
# FORWARDX_PANEL_TIME_SYNC=true
# 可选：使用逗号分隔的可信 HTTPS 时间来源覆盖默认来源
# FORWARDX_PANEL_TIME_SOURCES=https://www.cloudflare.com/cdn-cgi/trace,https://github.com/,https://www.baidu.com/
# 仅有一个可信时间来源时才建议开启
# FORWARDX_PANEL_TIME_ALLOW_SINGLE_SOURCE=false

# ==================== Telegram 机器人（可选） ====================
# 从 @BotFather 获取 Bot Token。也可以登录后台后在「系统设置」中填写。
# TELEGRAM_BOT_TOKEN=123456789:replace-with-your-bot-token
# 是否启用长轮询。默认 true，不需要配置 webhook。
# TELEGRAM_BOT_POLLING=true

# 管理员邮箱和密码在首次访问面板的初始化向导中创建。
# 为避免环境变量意外覆盖生产凭据，面板不支持通过 ADMIN_PASSWORD 重置管理员密码。
